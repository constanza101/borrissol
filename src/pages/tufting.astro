---
/**
 * Tufting landing — default-locale (CA) route, served at /tufting.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/tufting.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import TuftingLanding from '../components/landings/TuftingLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.tuf.title')}
  description={t('page.tuf.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <TuftingLanding />
  </main>
  <Footer />
</Layout>
