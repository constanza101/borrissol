---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Gallery from '../components/sections/Gallery.astro';
import Footer from '../components/layout/Footer.astro';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');

const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/gallery/*.jpg',
  { eager: true }
);

const altPrefix = t('gallery.image.alt');
const images = Object.entries(galleryModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module], i) => ({
    src: module.default,
    alt: `${altPrefix} ${i + 1}`,
  }));
---

<Layout
  title={t('page.gallery.title')}
  description={t('page.gallery.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Gallery images={images} />
  </main>
  <Footer />
</Layout>
