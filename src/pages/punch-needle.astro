---
/**
 * Punch needle landing — default-locale (CA) route, served at /punch-needle.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/punch-needle.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PunchNeedleLanding from '../components/PunchNeedleLanding.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.pn.title')}
  description={t('page.pn.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <PunchNeedleLanding />
  </main>
  <Footer />
</Layout>
