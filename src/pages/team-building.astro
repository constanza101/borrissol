---
/**
 * Team Building landing — default-locale (CA) route, served at /team-building.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/team-building.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import TeamBuildingLanding from '../components/landings/TeamBuildingLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.tb.title')}
  description={t('page.tb.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <TeamBuildingLanding />
  </main>
  <Footer />
</Layout>
