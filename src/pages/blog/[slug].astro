---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { waHref } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find(p => p.id === slug);

if (!post) return Astro.redirect('/blog');

const { Content } = await render(post);
const formattedDate = new Date(post.data.publishedAt).toLocaleDateString('ca-ES', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---

<Layout
  title={post.data.title}
  description={post.data.summary}
  ogImage={post.data.coverImage}
  caOnly
>
  <Navbar />
  <main id="main-content" class="post-main">

    <div class="post-header">
      <a href="/blog" class="post-back">← Blog</a>
      <p class="post-date">{formattedDate}</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-summary">{post.data.summary}</p>
    </div>

    {post.data.coverImage && (
      <div class="post-cover">
        <img src={post.data.coverImage} alt={post.data.title} width="1200" height="630" loading="eager" />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>

    <aside class="post-cta">
      <h2 class="post-cta-title">Vols provar-ho a Borrissol?</h2>
      <p class="post-cta-text">
        Viu l'experiència del tufting en persona al nostre taller de Mataró. El
        taller Pelusa és ideal per començar de zero: sense experiència prèvia,
        te'n portes la teva pròpia creació tèxtil a casa.
      </p>
      <a
        href={waHref('Hola! Vinc del blog i vull informació sobre el taller de tufting.')}
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        Reserva el teu taller
      </a>
    </aside>

    <div class="post-footer">
      <a href="/blog" class="btn btn-secondary">← Tornar al blog</a>
    </div>

  </main>
  <Footer />
</Layout>

<style>
  .post-main {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    padding-top: calc(var(--space-xl) + 60px);
  }

  .post-back {
    font-size: var(--font-size-ui);
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-weight-btn);
  }

  .post-back:hover { color: var(--color-black); }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-default);
  }

  .post-date {
    font-size: var(--font-size-ui);
    color: var(--color-muted);
    margin-top: var(--space-sm);
  }

  .post-title {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-black);
  }

  .post-summary {
    font-size: var(--font-size-p1);
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-xs);
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-content {
    font-size: var(--font-size-p2);
    line-height: 1.75;
    color: var(--color-black);
  }

  .post-content :global(h2) {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--letter-spacing-heading);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(h3) {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--letter-spacing-heading);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .post-content :global(img) {
    width: 100%;
    border-radius: var(--radius-xs);
    margin: var(--space-lg) 0;
  }

  .post-content :global(a) {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(ul), .post-content :global(ol) {
    padding-left: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .post-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .post-cta {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--bg-section);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .post-cta-title {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-black);
    margin: 0;
  }

  .post-cta-text {
    font-size: var(--font-size-p2);
    line-height: var(--line-height-body);
    color: var(--fg-muted);
    margin: 0;
  }

  .post-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border-default);
  }

  @media (max-width: 540px) {
    .post-main { padding: var(--space-lg) var(--space-sm); padding-top: calc(var(--space-xl) + 60px); }
  }
</style>
