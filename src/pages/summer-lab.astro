---
/**
 * Summer Textile Lab landing — default-locale (CA) route, served at /summer-lab.
 * The page stays live year-round (so it keeps its search ranking); only the
 * promotional home card is seasonal (see src/config/seasonal.ts). The /es, /en,
 * /fr variants are generated by src/pages/[lang]/summer-lab.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import SummerLabLanding from '../components/landings/SummerLabLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.sl.title')}
  description={t('page.sl.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <SummerLabLanding />
  </main>
  <Footer />
</Layout>
