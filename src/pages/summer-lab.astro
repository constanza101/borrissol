---
/**
 * Summer Textile Lab landing — default-locale (CA) route, served at /summer-lab.
 * Seasonal: while the course is hidden (see src/config/seasonal.ts) this route
 * 301-redirects to the homepage so the URL doesn't show a stale offering. The
 * /es, /en, /fr variants are generated by src/pages/[lang]/summer-lab.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SummerLabLanding from '../components/SummerLabLanding.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import { isSummerLabVisible } from '../config/seasonal';

if (!isSummerLabVisible()) {
  return Astro.redirect('/', 301);
}

const t = useTranslations('ca');
---

<Layout
  title={t('page.sl.title')}
  description={t('page.sl.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <SummerLabLanding />
  </main>
  <Footer />
</Layout>
