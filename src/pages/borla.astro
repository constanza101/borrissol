---
/**
 * Borla landing — default-locale (CA) route, served at /borla.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/borla.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import BorlaLanding from '../components/landings/BorlaLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.borla.title')}
  description={t('page.borla.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <BorlaLanding />
  </main>
  <Footer />
</Layout>
