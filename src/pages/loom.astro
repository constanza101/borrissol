---
/**
 * Loom / weaving landing — default-locale (CA) route, served at /loom.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/loom.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LoomLanding from '../components/LoomLanding.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.loom.title')}
  description={t('page.loom.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <LoomLanding />
  </main>
  <Footer />
</Layout>
