---
/**
 * Pelussetes landing — default-locale (CA) route, served at /pelussetes.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/pelussetes.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import PelussetesLanding from '../components/landings/PelussetesLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.pel.title')}
  description={t('page.pel.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <PelussetesLanding />
  </main>
  <Footer />
</Layout>
