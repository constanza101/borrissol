---
/**
 * Borla landing — dynamic route, generates /es/borla, /en/borla, /fr/borla
 * statically from a single source. The default-locale (CA) URL `/borla` is
 * served by src/pages/borla.astro.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import BorlaLanding from '../../components/landings/BorlaLanding.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter(l => l !== defaultLang)
    .map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('page.borla.title')}
  description={t('page.borla.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <BorlaLanding />
  </main>
  <Footer />
</Layout>
