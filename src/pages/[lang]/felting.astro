---
/**
 * Needle felting landing — dynamic route, generates /es/felting, /en/felting,
 * /fr/felting statically from a single source. The default-locale (CA) URL
 * `/felting` is served by src/pages/felting.astro.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import FeltreLanding from '../../components/landings/FeltreLanding.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter(l => l !== defaultLang)
    .map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('page.felt.title')}
  description={t('page.felt.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <FeltreLanding />
  </main>
  <Footer />
</Layout>
