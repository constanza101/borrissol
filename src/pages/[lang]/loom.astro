---
/**
 * LoomLanding route — generates /es/loom, /en/loom, /fr/loom statically.
 * The default-locale URL /loom is served by src/pages/loom.astro.
 */
import LandingPage from '../../layouts/LandingPage.astro';
import LoomLanding from '../../components/landings/LoomLanding.astro';
import { nonDefaultLangPaths } from '../../i18n/utils';

export const getStaticPaths = nonDefaultLangPaths;
---

<LandingPage titleKey="page.loom.title" descKey="page.loom.description">
  <LoomLanding />
</LandingPage>
