---
/**
 * Tufting landing — dynamic route, generates /es/tufting, /en/tufting,
 * /fr/tufting statically. The default-locale (CA) URL `/tufting` is served by
 * src/pages/tufting.astro.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import TuftingLanding from '../../components/landings/TuftingLanding.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations, nonDefaultLangPaths } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return nonDefaultLangPaths();
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('page.tuf.title')}
  description={t('page.tuf.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <TuftingLanding />
  </main>
  <Footer />
</Layout>
