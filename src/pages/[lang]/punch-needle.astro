---
/**
 * PunchNeedleLanding route — generates /es/punch-needle, /en/punch-needle, /fr/punch-needle statically.
 * The default-locale URL /punch-needle is served by src/pages/punch-needle.astro.
 */
import LandingPage from '../../layouts/LandingPage.astro';
import PunchNeedleLanding from '../../components/landings/PunchNeedleLanding.astro';
import { nonDefaultLangPaths } from '../../i18n/utils';

export const getStaticPaths = nonDefaultLangPaths;
---

<LandingPage titleKey="page.pn.title" descKey="page.pn.description">
  <PunchNeedleLanding />
</LandingPage>
