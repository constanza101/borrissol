---
/**
 * Punch needle landing — dynamic route, generates /es/punch-needle,
 * /en/punch-needle, /fr/punch-needle statically from a single source. The
 * default-locale (CA) URL `/punch-needle` is served by src/pages/punch-needle.astro.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import PunchNeedleLanding from '../../components/landings/PunchNeedleLanding.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter(l => l !== defaultLang)
    .map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('page.pn.title')}
  description={t('page.pn.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <PunchNeedleLanding />
  </main>
  <Footer />
</Layout>
