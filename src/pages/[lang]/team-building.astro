---
/**
 * TeamBuildingLanding route — generates /es/team-building, /en/team-building, /fr/team-building statically.
 * The default-locale URL /team-building is served by src/pages/team-building.astro.
 */
import LandingPage from '../../layouts/LandingPage.astro';
import TeamBuildingLanding from '../../components/landings/TeamBuildingLanding.astro';
import { nonDefaultLangPaths } from '../../i18n/utils';

export const getStaticPaths = nonDefaultLangPaths;
---

<LandingPage titleKey="page.tb.title" descKey="page.tb.description">
  <TeamBuildingLanding />
</LandingPage>
