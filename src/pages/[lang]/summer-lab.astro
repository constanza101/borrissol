---
/**
 * Summer Textile Lab landing — dynamic route, generates /es/summer-lab,
 * /en/summer-lab, /fr/summer-lab statically. The default-locale (CA) URL
 * `/summer-lab` is served by src/pages/summer-lab.astro.
 *
 * The page is live year-round (keeps its ranking); only the promotional home
 * card is seasonal (see src/config/seasonal.ts).
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import SummerLabLanding from '../../components/landings/SummerLabLanding.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter(l => l !== defaultLang)
    .map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('page.sl.title')}
  description={t('page.sl.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <SummerLabLanding />
  </main>
  <Footer />
</Layout>
