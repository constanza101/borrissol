---
/**
 * SummerLabLanding route — generates /es/summer-lab, /en/summer-lab, /fr/summer-lab statically.
 * The default-locale URL /summer-lab is served by src/pages/summer-lab.astro.
 */
import LandingPage from '../../layouts/LandingPage.astro';
import SummerLabLanding from '../../components/landings/SummerLabLanding.astro';
import { nonDefaultLangPaths } from '../../i18n/utils';

export const getStaticPaths = nonDefaultLangPaths;
---

<LandingPage titleKey="page.sl.title" descKey="page.sl.description">
  <SummerLabLanding />
</LandingPage>
