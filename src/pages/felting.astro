---
/**
 * Needle felting landing — default-locale (CA) route, served at /felting.
 * The /es, /en, /fr variants are generated by src/pages/[lang]/felting.astro.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import FeltreLanding from '../components/landings/FeltreLanding.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ca');
---

<Layout
  title={t('page.felt.title')}
  description={t('page.felt.description')}
  ogType="website"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <FeltreLanding />
  </main>
  <Footer />
</Layout>
