---
import '../styles/theme.css';
import Seo from '../components/layout/Seo.astro';
import WhatsAppFab from '../components/layout/WhatsAppFab.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);

// Re-export Seo props so pages only need to import Layout
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  canonicalUrl?: string;
  noindex?: boolean;
  caOnly?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
}

const seoProps = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://maps.googleapis.com" />
    <link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    <!-- Favicons — full set for browser tabs, iOS, Android, PWA, Google search -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ff058b" />

    <!-- All SEO, OG, Twitter Card and JSON-LD -->
    <Seo {...seoProps} />

    <!-- Google Consent Mode v2 — must run BEFORE gtag.js loads -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage:  'denied',
        ad_storage:         'denied',
        ad_user_data:       'denied',
        ad_personalization: 'denied',
        wait_for_update:    500
      });
      // Restore previous consent on return visits before GA fires
      if (localStorage.getItem('cookie_consent') === 'accepted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7M3T8SNNEB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7M3T8SNNEB');
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('skip.link')}</a>
    <slot />
    <WhatsAppFab />
    <CookieBanner />
    <!-- WhatsApp conversion tracking — every CTA on the site is a wa.me link.
         A single delegated listener fires a GA4 event on click so organic
         reservations become measurable (which page/section drives contacts).
         Respects Consent Mode: gtag queues the event and only sends it with
         the user's analytics consent state. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href*="wa.me"]');
        if (!link) return;
        if (typeof gtag !== 'function') return;
        var section = link.closest('[id]');
        gtag('event', 'whatsapp_click', {
          event_category: 'engagement',
          page_path: location.pathname,
          link_location: section ? section.id : 'unknown',
        });
      });
    </script>
    <!-- Scroll reveal — IntersectionObserver, fires once, respects prefers-reduced-motion -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -32px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
