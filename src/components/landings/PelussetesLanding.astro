---
/**
 * Pelussetes landing — dedicated, indexable page for the express group tufting
 * workshop (birthdays, hen parties, events). All copy comes from the i18n
 * catalog (pel.* keys); this component is language-agnostic and is reused by
 * the CA root route (/pelussetes) and the [lang] route.
 *
 * Typography uses the .text-* utility classes (Hard Rule #15); scoped CSS holds
 * layout only. Includes a Course JSON-LD node with the per-person price.
 */
import { Picture } from 'astro:assets';
import LandingHero from '../ui/LandingHero.astro';
import FinalCta from '../ui/FinalCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import FeatureCard from '../ui/FeatureCard.astro';
import Faq from '../ui/Faq.astro';
import CourseSchema from '../ui/CourseSchema.astro';
import DetailsList from '../ui/DetailsList.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/taller-tufting.jpg';
import detailImg from '../../assets/images/grupo2.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.pel.landing'));

const occasions = [1, 2, 3].map(n => ({
  title: t(`pel.occasion.${n}.title` as any),
  desc:  t(`pel.occasion.${n}.desc` as any),
}));

const steps = [1, 2, 3].map(n => ({
  title: t(`pel.how.${n}.title` as any),
  desc:  t(`pel.how.${n}.desc` as any),
}));

const details = [
  { label: t('pel.details.price.label'),    value: t('pel.details.price.value') },
  { label: t('pel.details.group.label'),    value: t('pel.details.group.value') },
  { label: t('pel.details.duration.label'), value: t('pel.details.duration.value') },
  { label: t('pel.details.project.label'),  value: t('pel.details.project.value') },
  { label: t('pel.details.includes.label'), value: t('pel.details.includes.value') },
  { label: t('pel.details.pickup.label'),   value: t('pel.details.pickup.value') },
  { label: t('pel.details.location.label'), value: t('pel.details.location.value') },
];

const faqs = [1, 2, 3, 4].map(n => ({
  q: t(`pel.faq.q${n}` as any),
  a: t(`pel.faq.a${n}` as any),
}));

---

<article class="pel">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t('pel.eyebrow')}
    headline={t('pel.headline')}
    lead={t('pel.lead')}
    cta={t('pel.cta')}
    ctaHref={ctaHref}
    img={heroImg}
    alt="Grupo de amigas creando tapices en un taller de tufting Pelussetes en Borrissol, Mataró"
    imgWidth={2957}
    imgHeight={2085}
  />

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <section class="pel-section pel-intro" aria-labelledby="pel-intro-heading">
    <h2 id="pel-intro-heading" class="text-h2 pel-h2">{t('pel.intro.title')}</h2>
    <p class="text-p2 pel-body">{t('pel.intro.body')}</p>
  </section>

  <!-- ── Occasions ────────────────────────────────────────────────────── -->
  <section class="pel-section pel-occasions" aria-labelledby="pel-occasions-heading">
    <h2 id="pel-occasions-heading" class="text-h2 pel-h2">{t('pel.occasions.title')}</h2>
    <div class="pel-occasions-grid">
      {occasions.map(o => (
        <FeatureCard title={o.title} desc={o.desc} />
      ))}
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="pel-section pel-how" aria-labelledby="pel-how-heading">
    <h2 id="pel-how-heading" class="text-h2 pel-h2">{t('pel.how.title')}</h2>
    <ol class="pel-steps">
      {steps.map((s, i) => (
        <li class="pel-step">
          <span class="pel-step-num">{i + 1}</span>
          <div class="pel-step-text">
            <h3 class="text-h4 pel-step-title">{s.title}</h3>
            <p class="text-p2 text-muted pel-step-desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Details + image ──────────────────────────────────────────────── -->
  <section class="pel-section pel-details" aria-labelledby="pel-details-heading">
    <div class="pel-details-layout">
      <div class="pel-details-text">
        <h2 id="pel-details-heading" class="text-h2 pel-h2">{t('pel.details.title')}</h2>
        <DetailsList details={details} />
        <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary pel-details-cta">{t('pel.cta')}</a>
      </div>
      <div class="media pel-details-img-wrap">
        <Picture
          src={detailImg}
          widths={[400, 600, 800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          formats={['avif', 'webp']}
          alt="Participantes en un taller de tufting en grupo en Borrissol, Mataró"
          width={3000}
          height={4000}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t('pel.faq.title')} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t('pel.final.title')}
    body={t('pel.final.body')}
    cta={t('pel.final.cta')}
    ctaHref={ctaHref}
  />

</article>

<CourseSchema name={t('pel.headline')} description={t('page.pel.description')} courseWorkload="P2H" price="68" />

<style>
  .pel {
    background: var(--color-white);
  }

  /* ── Shared section ───────────────────────────────────────────────── */
  .pel-section {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--layout-page-padding-h);
  }

  /* Typography from .text-* utilities; scoped rules below are layout only. */
  .pel-h2 {
    margin: 0 0 var(--space-md);
  }

  .pel-body {
    margin: 0;
    max-width: 720px;
  }

  /* ── Occasions ────────────────────────────────────────────────────── */
  .pel-occasions {
    background: var(--bg-section);
    max-width: none;
  }

  .pel-occasions > .pel-h2 {
    max-width: var(--layout-max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .pel-occasions-grid {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  /* ── How it works ─────────────────────────────────────────────────── */
  .pel-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
  }

  .pel-step {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  /* Numbered badge — bespoke circular element, no typography utility fits. */
  .pel-step-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--font-size-p2);
    font-weight: var(--font-weight-btn);
  }

  .pel-step-title {
    margin: 0 0 var(--space-xs);
  }

  .pel-step-desc {
    margin: 0;
  }

  /* ── Details ──────────────────────────────────────────────────────── */
  .pel-details-layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .pel-details-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Spacing to the list above (was the list margin before <DetailsList>). */
  .pel-details-cta {
    margin-top: var(--space-lg);
  }

  .pel-details-img-wrap {
    aspect-ratio: 3 / 4;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {

    .pel-occasions-grid {
      grid-template-columns: 1fr;
    }

    .pel-details-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
