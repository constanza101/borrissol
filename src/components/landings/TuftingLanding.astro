---
/**
 * Tufting landing — hub for the flagship service. Explains the technique, lists
 * the four individual formats (Pelusa / Floc / Vellut / Pelut, with real sizes,
 * durations and prices reused from the i18n catalog) and routes group interest
 * to the dedicated Pelussetes and Team Building landings.
 *
 * All copy from the i18n catalog. Skeleton from the shared landing components;
 * the individual-formats band stays bespoke because it deliberately widens past
 * the layout width. Course JSON-LD with an AggregateOffer covering the
 * individual price range.
 */
import LandingHero from '../ui/LandingHero.astro';
import LandingSection from '../ui/LandingSection.astro';
import FinalCta from '../ui/FinalCta.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';
import Faq from '../ui/Faq.astro';
import CourseSchema from '../ui/CourseSchema.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/offer-tufting.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.tuf.landing'));
const pelussetesPath   = localizedPath(lang, '/pelussetes');
const teamBuildingPath = localizedPath(lang, '/team-building');

// Individual formats — real data, same source as the home tufting panel.
const levels = [
  { name: 'Pelusa', level: t('tufting.level.express'),      size: '50×50 cm', duration: t('tufting.dur.4'),  price: '78€',  href: waHref(t('wa.tufting.pelusa')) },
  { name: 'Floc',   level: t('tufting.level.intro'),        size: '50×50 cm', duration: t('tufting.dur.6'),  price: '108€', href: waHref(t('wa.tufting.floc')) },
  { name: 'Vellut', level: t('tufting.level.intermediate'), size: '70×70 cm', duration: t('tufting.dur.8'),  price: '158€', href: waHref(t('wa.tufting.vellut')) },
  { name: 'Pelut',  level: t('tufting.level.pro'),          size: '80×80 cm', duration: t('tufting.dur.10'), price: '181€', href: waHref(t('wa.tufting.pelut')) },
];

const groupFormats = [
  { title: t('tuf.group.pel.title'), desc: t('tuf.group.pel.desc'), cta: t('tuf.group.pel.cta'), href: pelussetesPath },
  { title: t('tuf.group.tb.title'),  desc: t('tuf.group.tb.desc'),  cta: t('tuf.group.tb.cta'),  href: teamBuildingPath },
];

const faqs = [1, 2, 3].map(n => ({
  q: t.dyn(`tuf.faq.q${n}`),
  a: t.dyn(`tuf.faq.a${n}`),
}));

---

<article class="tuf">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t('tuf.eyebrow')}
    headline={t('tuf.headline')}
    lead={t('tuf.lead')}
    cta={t('tuf.cta')}
    ctaHref={ctaHref}
    img={heroImg}
    alt="Persona creando una alfombra con pistola de tufting en el taller Borrissol, Mataró"
    imgWidth={2000}
    imgHeight={1480}
  />

  <!-- ── What is it ───────────────────────────────────────────────────── -->
  <LandingSection id="tuf-what" title={t('tuf.what.title')} tight>
    <p class="text-p2 measure">{t('tuf.what.body')}</p>
  </LandingSection>

  <!-- ── Individual formats — bespoke: wider than the layout ──────────── -->
  <section class="tuf-individual" aria-labelledby="tuf-individual-heading">
    <h2 id="tuf-individual-heading" class="text-h2 tuf-individual-title">{t('tuf.individual.title')}</h2>
    <p class="text-p2 text-muted tuf-individual-intro">{t('tuf.individual.intro')}</p>
    <div class="tuf-levels-grid">
      {levels.map(lv => (
        <div class="card tuf-level-card">
          <h3 class="text-h4 tuf-level-name">{lv.name}</h3>
          <span class="text-ui text-muted tuf-level-tag">{lv.level}</span>
          <dl class="tuf-level-specs">
            <div class="tuf-level-spec">
              <dt class="text-ui text-muted">{t('tuf.col.size')}</dt>
              <dd class="text-p2 tuf-level-spec-value">{lv.size}</dd>
            </div>
            <div class="tuf-level-spec">
              <dt class="text-ui text-muted">{t('tuf.col.duration')}</dt>
              <dd class="text-p2 tuf-level-spec-value">{lv.duration}</dd>
            </div>
            <div class="tuf-level-spec">
              <dt class="text-ui text-muted">{t('tuf.col.price')}</dt>
              <dd class="text-p2 tuf-level-spec-value">{lv.price}</dd>
            </div>
          </dl>
          <a href={lv.href} target="_blank" rel="noopener noreferrer" class="btn btn-secondary tuf-level-cta">{t('ws.cta')}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Group formats ────────────────────────────────────────────────── -->
  <LandingSection id="tuf-group" title={t('tuf.group.title')}>
    <p class="text-p2 text-muted measure tuf-group-intro">{t('tuf.group.intro')}</p>
    <div class="tuf-group-grid">
      {groupFormats.map(g => (
        <div class="card tuf-group-card">
          <h3 class="text-h4 tuf-group-name">{g.title}</h3>
          <p class="text-p2 text-muted tuf-group-desc">{g.desc}</p>
          <a href={g.href} class="btn btn-secondary tuf-group-cta">{g.cta}</a>
        </div>
      ))}
    </div>
  </LandingSection>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t('tuf.faq.title')} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t('tuf.final.title')}
    body={t('tuf.final.body')}
    cta={t('tuf.final.cta')}
    ctaHref={ctaHref}
  />

</article>

<!-- AggregateOffer over the individual price range. -->
<CourseSchema name={t('tuf.headline')} description={t('page.tuf.description')} priceRange={{ low: '78', high: '181' }} />

<style>
  .tuf {
    background: var(--color-white);
  }

  /* ── Individual formats ───────────────────────────────────────────── */
  .tuf-individual {
    background: var(--bg-section);
    padding: var(--space-xl) var(--layout-page-padding-h);
  }

  /* Widen this block ~30% beyond the layout width so the four price cards are
     less cramped — it eats into the side margins on purpose. */
  .tuf-individual-title,
  .tuf-individual-intro,
  .tuf-levels-grid {
    max-width: calc(var(--layout-max-width) * 1.3);
    margin-left: auto;
    margin-right: auto;
  }

  .tuf-individual-title {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .tuf-individual-intro {
    margin-top: 0;
    margin-bottom: var(--space-lg);
  }

  .tuf-levels-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .tuf-level-card {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tuf-level-name {
    margin: 0;
  }

  .tuf-level-tag {
    display: block;
  }

  .tuf-level-specs {
    margin: var(--space-sm) 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tuf-level-spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    border-bottom: var(--border-default);
  }

  .tuf-level-spec-value {
    margin: 0;
  }

  .tuf-level-cta {
    align-self: flex-start;
    margin-top: auto;
    border-radius: var(--radius-sharp);
    font-size: var(--font-size-ui);
  }

  /* ── Group formats ────────────────────────────────────────────────── */
  .tuf-group-intro {
    margin-bottom: var(--space-lg);
  }

  .tuf-group-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .tuf-group-card {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .tuf-group-name {
    margin: 0;
  }

  .tuf-group-desc {
    margin: 0;
    flex: 1;
  }

  .tuf-group-cta {
    margin-top: var(--space-md);
    border-radius: var(--radius-sharp);
    font-size: var(--font-size-ui);
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .tuf-levels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .tuf-group-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .tuf-levels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
