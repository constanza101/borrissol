---
/**
 * Borla landing — dedicated, indexable page for the monthly textile workshop.
 * All copy comes from the i18n catalog (borla.* keys + reused offer.*.name for
 * technique titles); this component is language-agnostic and is reused by the
 * CA root route (/borla) and the [lang] route.
 *
 * Skeleton from the shared landing components; scoped CSS holds only the
 * techniques grid. Includes a Course JSON-LD node (price is "on request", so
 * no offer price is asserted).
 */
import LandingHero from '../ui/LandingHero.astro';
import LandingSection from '../ui/LandingSection.astro';
import FinalCta from '../ui/FinalCta.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';
import Faq from '../ui/Faq.astro';
import TechniqueCard from '../ui/TechniqueCard.astro';
import CourseSchema from '../ui/CourseSchema.astro';
import DetailsList from '../ui/DetailsList.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/grupal.png';
import imgFelting from '../../assets/images/offer-felting.jpg';
import imgPunch from '../../assets/images/offer-punch-needle.jpg';
import imgLoom from '../../assets/images/offer-loom.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.borla.landing'));
// Localized paths to each technique's dedicated landing (ca = no prefix).
const feltingPath = localizedPath(lang, '/felting');
const punchPath   = localizedPath(lang, '/punch-needle');
const loomPath    = localizedPath(lang, '/loom');

// Technique names reuse the existing offer.* catalog (single source of truth);
// descriptions are Borla-specific (borla.*.desc). `href` links to each
// technique's dedicated landing.
const techniques = [
  { name: t('offer.embroidery.name'), desc: t('borla.felting.desc'), img: imgFelting, width: 2000, height: 2000, alt: 'Figuras de fieltro agujado creadas en el taller Borrissol, Mataró', href: feltingPath },
  { name: t('offer.punch.name'),      desc: t('borla.punch.desc'),   img: imgPunch,   width: 2000, height: 1500, alt: 'Diseño de punch needle con lana sobre tela en el taller Borrissol, Mataró', href: punchPath },
  { name: t('offer.loom.name'),       desc: t('borla.loom.desc'),    img: imgLoom,    width: 2000, height: 2000, alt: 'Tejido en telar artesanal con hilos de colores en el taller Borrissol, Mataró', href: loomPath },
];

const details = [
  { label: t('borla.details.format.label'),     value: t('borla.details.format.value') },
  { label: t('borla.details.price.label'),      value: t('borla.details.price.value') },
  { label: t('borla.details.materials.label'),  value: t('borla.details.materials.value') },
  { label: t('borla.details.techniques.label'), value: t('borla.details.techniques.value') },
  { label: t('borla.details.location.label'),   value: t('borla.details.location.value') },
];

const faqs = [1, 2, 3].map(n => ({
  q: t.dyn(`borla.faq.q${n}`),
  a: t.dyn(`borla.faq.a${n}`),
}));

---

<article class="borla">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t('borla.eyebrow')}
    headline={t('borla.headline')}
    lead={t('borla.lead')}
    cta={t('borla.cta')}
    ctaHref={ctaHref}
    img={heroImg}
    alt="Grupo creando técnicas textiles en el taller mensual Borla de Borrissol, Mataró"
    imgWidth={894}
    imgHeight={644}
    widths={[480, 768, 894]}
  />

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <LandingSection id="borla-intro" title={t('borla.intro.title')}>
    <p class="text-p2 measure">{t('borla.intro.body')}</p>
    <p class="text-p2 text-muted measure borla-note">{t('borla.materials.note')}</p>
  </LandingSection>

  <!-- ── Techniques ───────────────────────────────────────────────────── -->
  <LandingSection id="borla-tech" title={t('borla.tech.title')} tint>
    <p class="text-p2 text-muted measure borla-tech-intro">{t('borla.tech.intro')}</p>
    <div class="borla-tech-grid">
      {techniques.map(tech => (
        <TechniqueCard
          name={tech.name}
          desc={tech.desc}
          img={tech.img}
          width={tech.width}
          height={tech.height}
          alt={tech.alt}
          href={tech.href}
        />
      ))}
    </div>
  </LandingSection>

  <!-- ── Details ──────────────────────────────────────────────────────── -->
  <LandingSection id="borla-details" title={t('borla.details.title')}>
    <DetailsList details={details} />
  </LandingSection>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t('borla.faq.title')} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t('borla.final.title')}
    body={t('borla.final.body')}
    cta={t('borla.final.cta')}
    ctaHref={ctaHref}
  />

</article>

<!-- No price asserted — it is "on request". -->
<CourseSchema name={t('borla.headline')} description={t('page.borla.description')} courseWorkload="PT2H" />

<style>
  .borla {
    background: var(--color-white);
  }

  .borla-note {
    margin-top: var(--space-md);
  }

  /* ── Techniques ───────────────────────────────────────────────────── */
  .borla-tech-intro {
    margin-bottom: var(--space-lg);
  }

  .borla-tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  /* Cards: see src/components/ui/TechniqueCard.astro */

  @media (max-width: 767px) {
    .borla-tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
