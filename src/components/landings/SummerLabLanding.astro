---
/**
 * Summer Textile Lab landing — seasonal course page. Explores all four textile
 * techniques (technique-focused, not product-focused — the projects aren't
 * fixed). Open to ages 12+. All copy from the i18n catalog (sl.* keys) plus
 * reused offer.*.name for technique titles.
 *
 * The page is live year-round; only the promotional home card is seasonal
 * (see src/config/seasonal.ts).
 *
 * Skeleton from the shared landing components.
 * Course JSON-LD carries the per-week price.
 */
import { Picture } from 'astro:assets';
import LandingHero from '../ui/LandingHero.astro';
import LandingSection from '../ui/LandingSection.astro';
import FinalCta from '../ui/FinalCta.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';
import TechniqueCard from '../ui/TechniqueCard.astro';
import CourseSchema from '../ui/CourseSchema.astro';
import DetailsList from '../ui/DetailsList.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/grupo2.jpg';
import introImg from '../../assets/images/summer-lab.jpg';
import imgTufting from '../../assets/images/offer-tufting.jpg';
import imgLoom from '../../assets/images/offer-loom.jpg';
import imgPunch from '../../assets/images/offer-punch-needle.jpg';
import imgFelting from '../../assets/images/offer-felting.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.sl.landing'));
// Internal links to the dedicated technique landings (ca = no prefix).
const tuftingPath = localizedPath(lang, '/tufting');
const loomPath    = localizedPath(lang, '/loom');
const feltingPath = localizedPath(lang, '/felting');
const punchPath   = localizedPath(lang, '/punch-needle');

// Technique names reuse the offer.* catalog; descriptions are summer-lab
// specific (sl.tech.*). `href` links to each technique's dedicated landing.
const techniques = [
  { name: t('offer.tufting.name'),    desc: t('sl.tech.tufting.desc'), img: imgTufting, width: 2000, height: 1480, alt: 'Tufting en el taller Borrissol, Mataró',                href: tuftingPath },
  { name: t('offer.loom.name'),       desc: t('sl.tech.loom.desc'),    img: imgLoom,    width: 2000, height: 2000, alt: 'Telar artesanal en el taller Borrissol, Mataró',       href: loomPath },
  { name: t('offer.punch.name'),      desc: t('sl.tech.punch.desc'),   img: imgPunch,   width: 2000, height: 1500, alt: 'Punch needle en el taller Borrissol, Mataró',          href: punchPath },
  { name: t('offer.embroidery.name'), desc: t('sl.tech.felting.desc'), img: imgFelting, width: 2000, height: 2000, alt: 'Fieltro agujado en el taller Borrissol, Mataró',       href: feltingPath },
];

const details = [
  { label: t('sl.details.price.label'),     value: t('sl.details.price.value') },
  { label: t('sl.details.schedule.label'),  value: t('sl.details.schedule.value') },
  { label: t('sl.details.age.label'),       value: t('sl.details.age.value') },
  { label: t('sl.details.group.label'),     value: t('sl.details.group.value') },
  { label: t('sl.details.materials.label'), value: t('sl.details.materials.value') },
  { label: t('sl.details.location.label'),  value: t('sl.details.location.value') },
];

---

<article class="sl">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t('sl.eyebrow')}
    headline={t('sl.headline')}
    lead={t('sl.lead')}
    cta={t('sl.cta')}
    ctaHref={ctaHref}
    img={heroImg}
    alt="Grupo creando en el Laboratorio Textil de Verano de Borrissol, Mataró"
    imgWidth={2200}
    imgHeight={2933}
    aspect="3 / 4"
  />

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <LandingSection id="sl-intro" title={t('sl.intro.title')}>
    <p class="text-p2 measure">{t('sl.intro.body')}</p>
    <div class="media sl-intro-img-wrap">
      <Picture
        src={introImg}
        widths={[480, 768, 1100]}
        sizes="(max-width: 1000px) 100vw, 960px"
        formats={['avif', 'webp']}
        alt="Participantes creando en el Laboratorio Textil de Verano de Borrissol, Mataró"
        width={1600}
        height={900}
        loading="lazy"
      />
    </div>
  </LandingSection>

  <!-- ── Techniques ───────────────────────────────────────────────────── -->
  <LandingSection id="sl-tech" title={t('sl.tech.title')} tint>
    <p class="text-p2 text-muted measure sl-tech-intro">{t('sl.tech.intro')}</p>
    <div class="sl-tech-grid">
      {techniques.map(tech => (
        <TechniqueCard
          name={tech.name}
          desc={tech.desc}
          img={tech.img}
          width={tech.width}
          height={tech.height}
          alt={tech.alt}
          href={tech.href}
        />
      ))}
    </div>
  </LandingSection>

  <!-- ── Who is it for ────────────────────────────────────────────────── -->
  <LandingSection id="sl-who" title={t('sl.who.title')}>
    <p class="text-p2 measure">{t('sl.who.body')}</p>
  </LandingSection>

  <!-- ── Details ──────────────────────────────────────────────────────── -->
  <LandingSection id="sl-details" title={t('sl.details.title')}>
    <DetailsList details={details} />
  </LandingSection>

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t('sl.final.title')}
    body={t('sl.final.body')}
    cta={t('sl.final.cta')}
    ctaHref={ctaHref}
  />

</article>

<CourseSchema name={t('sl.headline')} description={t('page.sl.description')} price="125" />

<style>
  .sl {
    background: var(--color-white);
  }

  .sl-intro-img-wrap {
    margin-top: var(--space-lg);
    aspect-ratio: 16 / 9;
  }

  /* ── Techniques ───────────────────────────────────────────────────── */
  .sl-tech-intro {
    margin-bottom: var(--space-lg);
  }

  .sl-tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  /* Cards: see src/components/ui/TechniqueCard.astro */

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .sl-tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .sl-tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
