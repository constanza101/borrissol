---
/**
 * Loom / weaving (telar) landing — informational page targeting the
 * "taller telar / teler / weaving" search intent (a low-competition niche).
 * Explains the technique and funnels to where it's practised: the Borla monthly
 * workshop (internal link) and WhatsApp.
 *
 * All copy from the i18n catalog (loom.* keys). Typography uses .text-*
 * utilities (Hard Rule #15); scoped CSS = layout only.
 */
import { Picture } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import FeatureCard from '../ui/FeatureCard.astro';
import Faq from '../ui/Faq.astro';
import BorlaFunnel from '../ui/BorlaFunnel.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/offer-loom.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.loom.landing'));

const benefits = [1, 2, 3].map(n => ({
  title: t(`loom.benefit.${n}.title` as any),
  desc:  t(`loom.benefit.${n}.desc` as any),
}));

const faqs = [1, 2, 3].map(n => ({
  q: t(`loom.faq.q${n}` as any),
  a: t(`loom.faq.a${n}` as any),
}));
---

<article class="loom">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="loom-hero" aria-labelledby="loom-hero-heading">
    <div class="loom-hero-text">
      <span class="text-ui text-muted">{t('loom.eyebrow')}</span>
      <h1 id="loom-hero-heading" class="text-h1 loom-headline">{t('loom.headline')}</h1>
      <p class="text-p1 text-muted loom-lead">{t('loom.lead')}</p>
      <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t('loom.cta')}</a>
    </div>
    <div class="media loom-hero-img-wrap">
      <Picture
        src={heroImg}
        widths={[480, 768, 1000]}
        sizes="(max-width: 900px) 100vw, 50vw"
        formats={['avif', 'webp']}
        alt="Tejido en telar artesanal con hilos de colores en el taller Borrissol, Mataró"
        width={3024}
        height={3024}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ── What is it ───────────────────────────────────────────────────── -->
  <section class="loom-section loom-text" aria-labelledby="loom-what-heading">
    <h2 id="loom-what-heading" class="text-h2 loom-h2">{t('loom.what.title')}</h2>
    <p class="text-p2 loom-body">{t('loom.what.body')}</p>
  </section>

  <!-- ── What you can weave ───────────────────────────────────────────── -->
  <section class="loom-section loom-text" aria-labelledby="loom-create-heading">
    <h2 id="loom-create-heading" class="text-h2 loom-h2">{t('loom.create.title')}</h2>
    <p class="text-p2 loom-body">{t('loom.create.body')}</p>
  </section>

  <!-- ── Why / benefits ───────────────────────────────────────────────── -->
  <section class="loom-section loom-why" aria-labelledby="loom-why-heading">
    <h2 id="loom-why-heading" class="text-h2 loom-h2">{t('loom.why.title')}</h2>
    <div class="loom-benefits-grid">
      {benefits.map(b => (
        <FeatureCard title={b.title} desc={b.desc} />
      ))}
    </div>
  </section>

  <!-- ── Where to practise (funnel to Borla) ──────────────────────────── -->
  <BorlaFunnel
    title={t('loom.practice.title')}
    body={t('loom.practice.body')}
    cta={t('loom.practice.cta')}
  />

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t('loom.faq.title')} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <section class="loom-section loom-final" aria-labelledby="loom-final-heading">
    <h2 id="loom-final-heading" class="text-h2 loom-final-title">{t('loom.final.title')}</h2>
    <p class="text-p1 text-muted loom-final-body">{t('loom.final.body')}</p>
    <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t('loom.final.cta')}</a>
  </section>

</article>

<style>
  .loom {
    background: var(--color-white);
  }

  /* ── Shared section ───────────────────────────────────────────────── */
  .loom-section {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--layout-page-padding-h);
  }

  /* Typography from .text-* utilities; scoped rules below are layout only. */
  .loom-h2 {
    margin: 0 0 var(--space-md);
  }

  .loom-body {
    margin: 0;
    max-width: 720px;
  }

  .loom-text {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .loom-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--layout-page-padding-h);
    padding-top: calc(var(--space-xl) + 60px);
  }

  .loom-hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .loom-headline {
    margin: 0;
  }

  .loom-lead {
    margin: 0;
  }

  .loom-hero-img-wrap {
    aspect-ratio: 1 / 1;
  }


  /* ── Why / benefits ───────────────────────────────────────────────── */
  .loom-why {
    background: var(--bg-section);
    max-width: none;
  }

  .loom-why > .loom-h2 {
    max-width: var(--layout-max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .loom-benefits-grid {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  /* ── Final CTA ────────────────────────────────────────────────────── */
  .loom-final {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    border-top: var(--border-default);
  }

  .loom-final-title {
    margin: 0;
  }

  .loom-final-body {
    margin: 0;
    max-width: 560px;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .loom-hero {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .loom-benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
