---
/**
 * Shared technique landing (felting, punch needle, loom). These informational
 * pages have identical structure: hero → what is it → what you can create →
 * why / benefits → Borla funnel → FAQ → final CTA. All copy resolves from the
 * i18n catalog via `prefix`; per-technique config (images, frame aspect) comes
 * in as props.
 *
 * Pass `createImg` to lay the "what you can create" text next to a photo.
 * Use the `after-create` slot for a bespoke extra band (Punch Needle's TikTok
 * videos) — its markup and CSS stay in the calling component.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LandingHero from '../ui/LandingHero.astro';
import LandingSection from '../ui/LandingSection.astro';
import FinalCta from '../ui/FinalCta.astro';
import FeatureCard from '../ui/FeatureCard.astro';
import Faq from '../ui/Faq.astro';
import BorlaFunnel from '../ui/BorlaFunnel.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { waHref } from '../../config';

interface Props {
  /** i18n key prefix — all copy comes from `${prefix}.*` (felt, pn, loom). */
  prefix: string;
  /** Hero image and its frame. */
  img: ImageMetadata;
  alt: string;
  imgWidth: number;
  imgHeight: number;
  aspect?: string;
  /** Optional photo beside the "what you can create" text (3:4 frame). */
  createImg?: { src: ImageMetadata; alt: string; width: number; height: number };
}
const { prefix, img, alt, imgWidth, imgHeight, aspect, createImg } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t(`wa.${prefix}.landing` as any));

const benefits = [1, 2, 3].map(n => ({
  title: t(`${prefix}.benefit.${n}.title` as any),
  desc:  t(`${prefix}.benefit.${n}.desc` as any),
}));

const faqs = [1, 2, 3].map(n => ({
  q: t(`${prefix}.faq.q${n}` as any),
  a: t(`${prefix}.faq.a${n}` as any),
}));
---

<article class="technique">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t(`${prefix}.eyebrow` as any)}
    headline={t(`${prefix}.headline` as any)}
    lead={t(`${prefix}.lead` as any)}
    cta={t(`${prefix}.cta` as any)}
    ctaHref={ctaHref}
    img={img}
    alt={alt}
    imgWidth={imgWidth}
    imgHeight={imgHeight}
    aspect={aspect}
  />

  <!-- ── What is it ───────────────────────────────────────────────────── -->
  <LandingSection id={`${prefix}-what`} title={t(`${prefix}.what.title` as any)} tight>
    <p class="text-p2 measure">{t(`${prefix}.what.body` as any)}</p>
  </LandingSection>

  <!-- ── What you can create ──────────────────────────────────────────── -->
  {createImg ? (
    <LandingSection id={`${prefix}-create`}>
      <div class="create-layout">
        <div>
          <h2 id={`${prefix}-create-heading`} class="text-h2 create-title">{t(`${prefix}.create.title` as any)}</h2>
          <p class="text-p2 measure">{t(`${prefix}.create.body` as any)}</p>
        </div>
        <div class="media create-img-wrap">
          <Picture
            src={createImg.src}
            widths={[400, 600, 800]}
            sizes="(max-width: 900px) 100vw, 35vw"
            formats={['avif', 'webp']}
            alt={createImg.alt}
            width={createImg.width}
            height={createImg.height}
            loading="lazy"
          />
        </div>
      </div>
    </LandingSection>
  ) : (
    <LandingSection id={`${prefix}-create`} title={t(`${prefix}.create.title` as any)} tight>
      <p class="text-p2 measure">{t(`${prefix}.create.body` as any)}</p>
    </LandingSection>
  )}

  <!-- ── Bespoke extra band (e.g. Punch Needle videos) ────────────────── -->
  <slot name="after-create" />

  <!-- ── Why / benefits ───────────────────────────────────────────────── -->
  <LandingSection id={`${prefix}-why`} title={t(`${prefix}.why.title` as any)} tint>
    <div class="benefits-grid">
      {benefits.map(b => (
        <FeatureCard title={b.title} desc={b.desc} />
      ))}
    </div>
  </LandingSection>

  <!-- ── Where to practise (funnel to Borla) ──────────────────────────── -->
  <BorlaFunnel
    title={t(`${prefix}.practice.title` as any)}
    body={t(`${prefix}.practice.body` as any)}
    cta={t(`${prefix}.practice.cta` as any)}
  />

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t(`${prefix}.faq.title` as any)} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t(`${prefix}.final.title` as any)}
    body={t(`${prefix}.final.body` as any)}
    cta={t(`${prefix}.final.cta` as any)}
    ctaHref={ctaHref}
  />

</article>

<style>
  .technique {
    background: var(--color-white);
  }

  /* ── What you can create (with photo) ─────────────────────────────── */
  .create-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .create-title {
    margin: 0 0 var(--space-md);
  }

  .create-img-wrap {
    aspect-ratio: 3 / 4;
  }

  /* ── Why / benefits ───────────────────────────────────────────────── */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .create-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
