---
/**
 * Team Building landing — dedicated, indexable page for the
 * "team building creativo Barcelona" search intent. All copy comes from the
 * i18n catalog (tb.* keys); this component is language-agnostic and is reused
 * by both the CA root route (/team-building) and the [lang] route.
 *
 * Skeleton from the shared landing components. Includes a Course JSON-LD node
 * so Google can surface price/provider rich results for the workshop.
 */
import { Picture } from 'astro:assets';
import LandingHero from '../ui/LandingHero.astro';
import LandingSection from '../ui/LandingSection.astro';
import FinalCta from '../ui/FinalCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import FeatureCard from '../ui/FeatureCard.astro';
import Steps from '../ui/Steps.astro';
import Faq from '../ui/Faq.astro';
import CourseSchema from '../ui/CourseSchema.astro';
import DetailsList from '../ui/DetailsList.astro';
import { waHref } from '../../config';
import heroImg from '../../assets/images/ws-wrist-rest.jpg';
import projectImg from '../../assets/images/gallery/img_7713.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ctaHref = waHref(t('wa.tb.landing'));

const benefits = [1, 2, 3].map(n => ({
  title: t.dyn(`tb.benefit.${n}.title`),
  desc:  t.dyn(`tb.benefit.${n}.desc`),
}));

const details = [
  { label: t('tb.details.price.label'),    value: t('tb.details.price.value') },
  { label: t('tb.details.group.label'),    value: t('tb.details.group.value') },
  { label: t('tb.details.duration.label'), value: t('tb.details.duration.value') },
  { label: t('tb.details.project.label'),  value: t('tb.details.project.value') },
  { label: t('tb.details.includes.label'), value: t('tb.details.includes.value') },
  { label: t('tb.details.location.label'), value: t('tb.details.location.value') },
];

const steps = [1, 2, 3].map(n => ({
  title: t.dyn(`tb.how.${n}.title`),
  desc:  t.dyn(`tb.how.${n}.desc`),
}));

const faqs = [1, 2, 3, 4].map(n => ({
  q: t.dyn(`tb.faq.q${n}`),
  a: t.dyn(`tb.faq.a${n}`),
}));

---

<article class="tb">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <LandingHero
    eyebrow={t('tb.eyebrow')}
    headline={t('tb.headline')}
    lead={t('tb.lead')}
    cta={t('tb.cta')}
    ctaHref={ctaHref}
    img={heroImg}
    alt="Reposamuñecas de tufting creado en un taller de team building en Borrissol, Mataró"
    imgWidth={2000}
    imgHeight={1500}
  />

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <LandingSection id="tb-intro" title={t('tb.intro.title')}>
    <p class="text-p2 measure">{t('tb.intro.body')}</p>
  </LandingSection>

  <!-- ── Benefits ─────────────────────────────────────────────────────── -->
  <LandingSection id="tb-benefits" title={t('tb.benefits.title')} tint>
    <div class="tb-benefits-grid">
      {benefits.map(b => (
        <FeatureCard title={b.title} desc={b.desc} />
      ))}
    </div>
  </LandingSection>

  <!-- ── Details + project image ──────────────────────────────────────── -->
  <LandingSection id="tb-details">
    <div class="tb-details-layout">
      <div class="tb-details-text">
        <h2 id="tb-details-heading" class="text-h2 tb-details-title">{t('tb.details.title')}</h2>
        <DetailsList details={details} />
        <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary tb-details-cta">{t('tb.cta')}</a>
      </div>
      <div class="media tb-details-img-wrap">
        <Picture
          src={projectImg}
          widths={[400, 600, 800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          formats={['avif', 'webp']}
          alt="Creación textil de tufting hecha en el taller Borrissol, Mataró"
          width={1200}
          height={900}
          loading="lazy"
        />
      </div>
    </div>
  </LandingSection>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <LandingSection id="tb-how" title={t('tb.how.title')}>
    <Steps steps={steps} />
  </LandingSection>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Faq title={t('tb.faq.title')} faqs={faqs} />

  <!-- ── Final CTA ────────────────────────────────────────────────────── -->
  <FinalCta
    title={t('tb.final.title')}
    body={t('tb.final.body')}
    cta={t('tb.final.cta')}
    ctaHref={ctaHref}
  />

</article>

<CourseSchema name={t('tb.headline')} description={t('page.tb.description')} price="68" />

<style>
  .tb {
    background: var(--color-white);
  }

  /* ── Benefits ─────────────────────────────────────────────────────── */
  .tb-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  /* ── Details ──────────────────────────────────────────────────────── */
  .tb-details-layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .tb-details-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tb-details-title {
    margin: 0 0 var(--space-md);
  }

  /* Spacing to the list above (was the list margin before <DetailsList>). */
  .tb-details-cta {
    margin-top: var(--space-lg);
  }

  .tb-details-img-wrap {
    aspect-ratio: 1 / 1;
  }


  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .tb-benefits-grid {
      grid-template-columns: 1fr;
    }

    .tb-details-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
