---
/**
 * Reusable FAQ block for the landing pages: renders the visible accordion-free
 * Q&A list AND its FAQPage structured data from a single `faqs` array.
 * Replaces the per-landing duplicated FAQ sections.
 *
 * Typography via .text-* utilities (Hard Rule #15); scoped CSS = layout only.
 */
import FaqSchema from './FaqSchema.astro';

interface Props {
  title: string;
  faqs: { q: string; a: string }[];
}
const { title, faqs } = Astro.props;
---

<section class="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-h2 faq-title">{title}</h2>
  <div class="faq-list">
    {faqs.map(f => (
      <div class="card faq-item">
        <h3 class="text-h4 faq-q">{f.q}</h3>
        <p class="text-p2 text-muted faq-a">{f.a}</p>
      </div>
    ))}
  </div>
</section>

<FaqSchema faqs={faqs} />

<style>
  .faq {
    background: var(--bg-section);
    padding: var(--space-xl) var(--layout-page-padding-h);
  }

  .faq-title,
  .faq-list {
    max-width: var(--layout-max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .faq-title {
    margin: 0 auto var(--space-md);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .faq-item {
    padding: var(--space-lg);
  }

  .faq-q {
    margin: 0 0 var(--space-xs);
  }

  .faq-a {
    margin: 0;
  }
</style>
