---
import { getLangFromUrl, useTranslations, getAlternatePath, localizedPath } from '../../i18n/utils';
import { languages, type Lang } from '../../i18n/ui';
import { waHref } from '../../config';

const lang     = getLangFromUrl(Astro.url);
const t        = useTranslations(lang);
const altPaths = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map(l => [l, getAlternatePath(Astro.url, l)])
) as Record<Lang, string>;

// Full language autonyms — used as the accessible name of the switcher links
// (a screen reader says "Español" instead of spelling out "ES"). The visible
// label stays the short code from `languages`.
const langNames: Record<Lang, string> = {
  ca: 'Català',
  es: 'Español',
  en: 'English',
  fr: 'Français',
};

// Internal pages respect current language prefix (ca is default = no prefix).
// Site config has `trailingSlash: 'never'`, so non-default home is `/fr` not `/fr/`.
const homePath    = localizedPath(lang, '/');
const pressPath   = localizedPath(lang, '/press');
const galleryPath = localizedPath(lang, '/gallery');

// Anchors on the home page must be prefixed with the home path so they work
// from non-home pages (e.g. /press, /blog). Browsers treat same-path+hash
// as a same-page scroll, so this stays smooth on the home itself.
const anchors = {
  offer:     `${homePath}#offer`,
  workshops: `${homePath}#workshops`,
  process:   `${homePath}#process`,
  about:     `${homePath}#about`,
  faq:       `${homePath}#faq`,
};

// Current-page detection for aria-current="page" on route-based links.
// Astro.url.pathname does not include trailing slash, so we normalise.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrentPage = (href: string) => {
  const normalised = href.replace(/\/$/, '') || '/';
  return currentPath === normalised;
};
const blogHref = '/blog';
---

<header class="site-header">

  <!-- ── Main bar ── -->
  <nav class="site-nav" aria-label={t('a11y.nav.main')}>

    <a href={homePath} class="nav-brand" aria-label={t('a11y.nav.home')}>
      <span class="nav-brand-logo" aria-hidden="true"></span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      <li><a href={anchors.offer}>{t('nav.services')}</a></li>
      <li><a href={anchors.workshops}>{t('nav.workshops')}</a></li>
      <li><a href={anchors.process}>{t('nav.process')}</a></li>
      <li><a href={anchors.about}>{t('nav.about')}</a></li>
      <li><a href={anchors.faq}>FAQ</a></li>
      <li><a href={galleryPath} aria-current={isCurrentPage(galleryPath) ? 'page' : undefined}>{t('nav.gallery')}</a></li>
      <li><a href={pressPath} aria-current={isCurrentPage(pressPath) ? 'page' : undefined}>{t('nav.press')}</a></li>
      <li><a href={blogHref} aria-current={isCurrentPage(blogHref) ? 'page' : undefined}>Blog</a></li>
    </ul>

    <!-- Language switcher: the current language is a toggle; the others reveal
         in line to its left (click or hover), floating over the bar. Shown on
         every breakpoint. -->
    <div class="nav-lang-switch" aria-label={t('a11y.nav.lang')}>
      <ul class="nav-lang-reveal" id="nav-lang-reveal" role="list">
        {(Object.entries(languages) as [Lang, string][])
          .filter(([l]) => l !== lang)
          .map(([l, label]) => (
            <li>
              <a
                href={altPaths[l]}
                hreflang={l}
                lang={l}
                aria-label={langNames[l]}
                class="nav-lang-reveal-link"
              >{label}</a>
            </li>
          ))
        }
      </ul>
      <button
        class="nav-lang-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-lang-reveal"
      >
        {languages[lang]}
      </button>
    </div>

    <!-- Desktop CTA — last item before hamburger -->
    <a
      href={waHref(t('wa.general'))}
      class="btn btn-primary nav-cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('a11y.wa')}
    >
      {t('nav.cta')}
    </a>

    <!-- Mobile hamburger: two thin lines that animate into an X -->
    <button
      id="nav-hamburger"
      class="nav-hamburger"
      aria-label={t('a11y.nav.openMenu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hb" aria-hidden="true">
        <span class="hb-line"></span>
        <span class="hb-line"></span>
      </span>
    </button>

  </nav>

  <!-- ── Mobile dropdown ── -->
  <!-- Disclosure panel (not a modal dialog — no focus trap is promised).
       aria-hidden + visibility:hidden in CSS keep the closed panel out of
       both the accessibility tree AND the tab order. -->
  <div id="mobile-menu" class="nav-mobile" aria-hidden="true" aria-label={t('a11y.nav.menu')}>

    <ul class="nav-mobile-links" role="list">
      <li><a href={anchors.offer}>{t('nav.services')}</a></li>
      <li><a href={anchors.workshops}>{t('nav.workshops')}</a></li>
      <li><a href={anchors.process}>{t('nav.process')}</a></li>
      <li><a href={anchors.about}>{t('nav.about')}</a></li>
      <li><a href={anchors.faq}>FAQ</a></li>
      <li><a href={galleryPath} aria-current={isCurrentPage(galleryPath) ? 'page' : undefined}>{t('nav.gallery')}</a></li>
      <li><a href={pressPath} aria-current={isCurrentPage(pressPath) ? 'page' : undefined}>{t('nav.press')}</a></li>
      <li><a href={blogHref} aria-current={isCurrentPage(blogHref) ? 'page' : undefined}>Blog</a></li>
    </ul>

    <div class="nav-mobile-cta-wrap">
      <a
        href={waHref(t('wa.general'))}
        class="btn btn-primary nav-mobile-cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('a11y.wa')}
      >
        {t('nav.cta')}
      </a>
    </div>

  </div>

</header>

<script is:inline>
  // Preserve URL hash when switching language. The hash is purely client-side
  // (never reaches the server), so getAlternatePath cannot include it. We
  // append window.location.hash to the switcher links' href at click time so
  // the user stays on the same anchor after navigating.
  (function () {
    document.querySelectorAll('.nav-lang-reveal-link').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var hash = window.location.hash;
        if (!hash) return;
        var href = link.getAttribute('href');
        if (!href) return;
        // Avoid double-hash if the href already has one for some reason.
        if (href.indexOf('#') !== -1) return;
        e.preventDefault();
        window.location.href = href + hash;
      });
    });
  })();

  // Language switcher. .is-open is the single source of truth so a click can
  // always close the reveal — even while the pointer is still over it.
  //  • click toggles open/closed (authoritative; works on touch + keyboard).
  //  • on mouse devices, hover opens and leaving closes. Since a click-to-close
  //    leaves .is-open false and mouseenter won't refire until the pointer
  //    actually re-enters, the reveal stays closed as expected.
  //  • click-outside and Escape close it.
  (function () {
    var sw = document.querySelector('.nav-lang-switch');
    if (!sw) return;
    var toggle = sw.querySelector('.nav-lang-toggle');
    if (!toggle) return;

    function open()  { sw.classList.add('is-open');    toggle.setAttribute('aria-expanded', 'true'); }
    function close() { sw.classList.remove('is-open'); toggle.setAttribute('aria-expanded', 'false'); }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      sw.classList.contains('is-open') ? close() : open();
    });

    if (window.matchMedia('(hover: hover)').matches) {
      sw.addEventListener('mouseenter', open);
      sw.addEventListener('mouseleave', close);
    }

    document.addEventListener('click', function (e) {
      if (!sw.contains(e.target)) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();

  (function () {
    var btn  = document.getElementById('nav-hamburger');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    function openMenu() {
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
    }
    function closeMenu() {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    }

    btn.addEventListener('click', function () {
      menu.classList.contains('is-open') ? closeMenu() : openMenu();
    });
    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });
  })();
</script>

<style>
  /* ── Header shell — sticky pill container ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    padding: var(--space-sm) var(--space-md);
  }

  /* ── Pill nav bar ── */
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: color-mix(in srgb, var(--color-mid) 62%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border: 0.5px solid color-mix(in srgb, var(--color-black) 6%, transparent);
    border-radius: var(--radius-pill);
    padding: 10px 14px 10px var(--space-md);
    gap: var(--space-md);
    transition: background var(--t-normal);
  }

  /* Darken pill when mobile menu is open */
  .site-header:has(.nav-mobile.is-open) .site-nav {
    background: color-mix(in srgb, var(--color-mid) 88%, transparent);
  }

  /* Progressive scroll shrink — only where supported */
  @supports (animation-timeline: scroll()) {
    .site-nav {
      animation: pill-shrink linear both;
      animation-timeline: scroll();
      animation-range: 80px 420px;
    }
    @keyframes pill-shrink {
      to {
        transform: scale(0.88);
        box-shadow: var(--shadow-nav-scroll);
      }
    }
  }

  /* ── Brand ── */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch-target);
    text-decoration: none;
    flex-shrink: 0;
  }

  /* Logo recoloured via CSS mask (the SVG is monochrome) so it can go brand-pink
     on hover. viewBox 87.05×85.06 → ~33px wide at 32px tall. */
  .nav-brand-logo {
    height: 32px;
    width: 33px;
    display: block;
    background-color: var(--color-dark);
    -webkit-mask: url("/images/borrissol-pompom.svg") center / contain no-repeat;
    mask: url("/images/borrissol-pompom.svg") center / contain no-repeat;
    transition: background-color var(--t-fast);
  }
  .nav-brand:hover .nav-brand-logo {
    background-color: var(--color-accent);
  }

  /* ── Desktop links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch-target);
    font-size: var(--font-size-p2);
    font-weight: var(--font-weight-body);
    color: var(--color-black);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-fast);
  }
  .nav-links a:hover { color: var(--color-muted); }

  /* Current page indicator — medium weight to differentiate without
     adding a visual marker that would clash with the minimalist DS. */
  .nav-links a[aria-current="page"],
  .nav-mobile-links a[aria-current="page"] {
    font-weight: var(--font-weight-btn);
  }

  /* ── Language switcher: current label + others that reveal in line, to the
        left, floating over the bar (no layout push). Opens on hover, keyboard
        focus, or click (.is-open). Visible on every breakpoint. ── */
  .nav-lang-switch {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }

  .nav-lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: var(--min-touch-target);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-family-base);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-btn);
    letter-spacing: var(--letter-spacing-btn);
    text-transform: uppercase;
    color: var(--color-black);
  }

  /* Left-pointing caret; flips to point right (toward current) when open. */
  .nav-lang-toggle::before {
    content: '';
    display: block;
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(135deg);
    transition: transform 0.32s ease;
    flex-shrink: 0;
  }
  .nav-lang-switch.is-open .nav-lang-toggle::before {
    transform: rotate(-45deg);
  }

  /* The other languages, anchored just left of the current one. Absolute so
     they overlay the bar instead of pushing its content. */
  .nav-lang-reveal {
    position: absolute;
    right: calc(100% + var(--space-xs));
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    padding: 2px var(--space-xs);
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--color-white);
    border: var(--border-default);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.32s ease, visibility 0s linear 0.32s;
  }

  .nav-lang-reveal li { display: flex; }

  .nav-lang-reveal-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch-target);
    padding: 0 var(--space-xs);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-btn);
    letter-spacing: var(--letter-spacing-btn);
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    /* each item slides out from behind the current one */
    opacity: 0;
    transform: translateX(8px);
    transition: opacity 0.32s ease, transform 0.32s ease, color 0.15s ease;
  }
  .nav-lang-reveal-link:hover { color: var(--color-black); }

  /* Stagger: the item nearest the current language reveals first. */
  .nav-lang-reveal li:nth-last-child(2) .nav-lang-reveal-link { transition-delay: 0.08s; }
  .nav-lang-reveal li:nth-last-child(3) .nav-lang-reveal-link { transition-delay: 0.16s; }

  /* Open state is driven solely by .is-open (toggled by JS on click, and on
     hover for mouse devices) so a click can always close it, even while the
     pointer is still over the switch. */
  .nav-lang-switch.is-open .nav-lang-reveal {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.32s ease;
  }

  .nav-lang-switch.is-open .nav-lang-reveal-link {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-lang-reveal,
    .nav-lang-toggle::before { transition: none; }
    .nav-lang-reveal-link { transition: color 0.15s ease; transform: none; }
  }

  /* ── Desktop CTA — pill shape in pill nav ── */
  .nav-cta {
    flex-shrink: 0;
    min-height: var(--min-touch-target);
    padding: 0 1.5em;
    font-size: var(--font-size-ui);
    text-decoration: none;
  }

  /* ── Hamburger — hidden on desktop ── */
  .nav-hamburger { display: none; }

  /* ── Mobile dropdown — hidden outside mobile breakpoint ── */
  @media (min-width: 768px) {
    .nav-mobile { display: none; }
  }


  /* ================================================================
     MOBILE  (≤ 767px)
     ================================================================ */
  @media (max-width: 767px) {

    .nav-links { display: none; }
    .nav-cta   { display: none; }
    /* .nav-lang-switch stays visible in the bar on mobile; push it to the
       right so it sits next to the hamburger instead of mid-bar. */
    .nav-lang-switch { margin-left: auto; }

    /* Tighten pill padding on mobile */
    .site-nav {
      padding: 8px 8px 8px var(--space-md);
    }

    /* ── Hamburger button ── */
    .nav-hamburger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width:  var(--min-touch-target);
      min-height: var(--min-touch-target);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
    }

    /* ── Two-line icon ── */
    .hb {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 26px;
    }

    .hb-line {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--color-dark);
      border-radius: 1px;
      transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: center;
    }

    /* Open state → X */
    .nav-hamburger[aria-expanded="true"] .hb-line:nth-child(1) {
      transform: translateY(5px) rotate(45deg);
    }
    .nav-hamburger[aria-expanded="true"] .hb-line:nth-child(2) {
      transform: translateY(-5px) rotate(-45deg);
    }

    /* ── Floating dropdown panel ── */
    .nav-mobile {
      display: flex;
      flex-direction: column;
      width: 100%;
      background: color-mix(in srgb, var(--color-dark) 95%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 0.5px solid color-mix(in srgb, var(--color-white) 15%, transparent);
      border-radius: var(--radius-lg);
      margin-top: var(--space-xs);
      padding: 0 var(--space-md);
      gap: var(--space-xs);
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      /* visibility removes the closed panel's links from the tab order (they
         sit inside aria-hidden); the 0.3s delay lets the close animation play. */
      visibility: hidden;
      transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease,
                  visibility 0s linear 0.3s;
    }

    .nav-mobile.is-open {
      visibility: visible;
      /* No visibility delay when opening (the delayed one above is close-only). */
      transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease;
      /* Fill the viewport below the bar and scroll internally if the links
         don't all fit (dvh handles mobile browser chrome). */
      max-height: calc(100vh - 96px);
      max-height: calc(100dvh - 96px);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 1;
      padding: var(--space-sm) var(--space-md) var(--space-md);
      pointer-events: auto;
    }

    /* ── Dropdown links ── */
    .nav-mobile-links {
      list-style: none;
      display: flex;
      flex-direction: column;
    }

    .nav-mobile-links li {
      border-bottom: var(--border-default);
    }
    .nav-mobile-links li:first-child {
      border-top: var(--border-default);
    }

    .nav-mobile-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: var(--min-touch-target);
      padding: var(--space-md) 0;
      font-size: var(--font-size-h4);
      font-weight: var(--font-weight-body);
      color: var(--color-white);
      text-decoration: none;
      text-align: center;
      transition: color var(--t-fast);
    }
    .nav-mobile-links a:hover { color: var(--color-mid); }

    /* ── Dropdown CTA ── */
    .nav-mobile-cta-wrap {
      padding-top: var(--space-md);
    }

    .nav-mobile-cta {
      width: 100%;
      text-decoration: none;
      justify-content: center;
      padding: var(--space-sm) 0;
      font-size: var(--font-size-p3);
      border-radius: 0;
      /* Inverted on the dark panel so the CTA reads; btn-primary:hover still
         wins on hover, keeping the accent-pink state. */
      background: var(--color-white);
      color: var(--color-dark);
    }


  }
</style>
