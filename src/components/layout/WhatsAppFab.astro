---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { waHref } from '../../config';

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);
const href = waHref(t('wa.general'));
---

<div class="fab-stack">
  <button
    id="scroll-top-fab"
    class="fab fab--top is-hidden"
    aria-label={t('a11y.scrollTop')}
    type="button"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <a
    href={href}
    class="fab fab--wa"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t('a11y.wa')}
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413"/>
    </svg>
  </a>
</div>

<button
  id="scroll-down-fab"
  class="scroll-down"
  aria-label={t('a11y.scrollDown')}
  type="button"
>
  <svg width="48" height="22" viewBox="0 0 48 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="6 6 24 16 42 6"/>
  </svg>
</button>

<script is:inline>
  (function () {
    var upBtn   = document.getElementById('scroll-top-fab');
    var downBtn = document.getElementById('scroll-down-fab');

    if (upBtn) upBtn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    if (downBtn) downBtn.addEventListener('click', function () {
      window.scrollBy({ top: Math.round(window.innerHeight * 0.8), behavior: 'smooth' });
    });

    // Up button: hidden at the very top, shown after scrolling.
    // Down chevron: stays while there is more to scroll, hidden only once you
    // can't go any further down (or the page doesn't scroll at all).
    function update() {
      var doc = document.documentElement;
      if (upBtn) upBtn.classList.toggle('is-hidden', window.scrollY <= 4);
      if (downBtn) {
        var atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 4;
        downBtn.classList.toggle('is-hidden', atBottom);
      }
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>

<style>
  .fab-stack {
    position: fixed;
    right: var(--space-md);
    bottom: var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    z-index: 600;
  }

  .fab {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--color-dark);
    color: var(--color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.35);
    transition: transform var(--t-fast), opacity var(--t-fast), background var(--t-fast), color var(--t-fast);
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .fab:hover {
    transform: translateY(-2px);
  }
  .fab:active {
    transform: translateY(0) scale(0.97);
  }

  /* Scroll-to-top — primary button behaviour: dark, pink on hover. */
  .fab--top:hover {
    background: var(--btn-primary-hover-bg);
    color: var(--btn-primary-hover-color);
  }

  /* WhatsApp — brand green. */
  .fab--wa {
    background: var(--color-whatsapp);
  }
  .fab--wa:hover {
    opacity: 0.9;
  }

  /* Hidden state (toggled by JS on scroll position). */
  .fab.is-hidden { display: none; }

  /* Scroll-down hint — mobile only, floating bottom-centre. A bare wide chevron
     (no pill) that gently bounces to nudge scrolling; stays until the page
     bottom is reached. */
  .scroll-down {
    display: none;
    position: fixed;
    left: 50%;
    bottom: var(--space-md);
    transform: translateX(-50%);
    padding: var(--space-sm) var(--space-lg);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-dark);
    z-index: 600;
    transition: color var(--t-fast);
  }
  .scroll-down:hover { color: var(--color-accent); }

  /* Animate the chevron itself (the button keeps its translateX centering). */
  .scroll-down svg {
    animation: scroll-down-bounce 1.8s ease-in-out infinite;
  }
  @keyframes scroll-down-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-down svg { animation: none; }
  }

  @media (max-width: 640px) {
    .fab-stack {
      right: var(--space-sm);
      bottom: var(--space-sm);
    }
    .fab {
      width: 52px;
      height: 52px;
    }
    /* Present on mobile, shown only when at the top (not .is-hidden). */
    .scroll-down { display: inline-flex; }
    .scroll-down.is-hidden { display: none; }
  }
</style>
