---
/**
 * Honeycomb gallery — diamond-clipped tiles that morph to rounded squares
 * on hover (desktop) or tap (mobile). Adapted from haptichash CodePen
 * (eYojBbx). True honeycomb interlock: rows are HALF the image height,
 * so the bottom half of each image overlaps the top half of the next row.
 * The diamond clip-path means the visible content does NOT collide.
 *
 * Usage:
 *   <Gallery images={imagesArray} />
 *
 * Each item in `images` is { src: ImageMetadata, alt: string }.
 */
import { Picture, type ImageMetadata } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="gallery" aria-labelledby="gallery-heading">
  <div class="gallery-inner">

    <div class="gallery-header">
      <span class="gallery-eyebrow reveal">{t('gallery.eyebrow')}</span>
      <h2 id="gallery-heading" class="gallery-headline reveal" data-delay="1">{t('gallery.headline')}</h2>
    </div>

    <ul class="gallery-grid" role="list">
      {images.map(({ src, alt }) => (
        <li class="gallery-cell">
          <button class="gallery-tile" type="button" aria-label={alt}>
            <Picture
              src={src}
              widths={[240, 360, 540, 720]}
              sizes="(max-width: 540px) 40vw, (max-width: 1024px) 22vw, 16vw"
              formats={['avif', 'webp']}
              alt={alt}
              class="gallery-img"
              loading="lazy"
            />
          </button>
        </li>
      ))}
    </ul>

  </div>
</section>

<script is:inline>
  (function () {
    var grid = document.querySelector('.gallery-grid');
    if (!grid) return;

    var tiles = grid.querySelectorAll('.gallery-tile');

    tiles.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var wasActive = btn.classList.contains('is-active');
        grid.querySelectorAll('.gallery-tile.is-active').forEach(function (b) {
          b.classList.remove('is-active');
        });
        if (!wasActive) btn.classList.add('is-active');
      });
    });

    document.addEventListener('click', function (e) {
      if (!grid.contains(e.target)) {
        grid.querySelectorAll('.gallery-tile.is-active').forEach(function (b) {
          b.classList.remove('is-active');
        });
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        grid.querySelectorAll('.gallery-tile.is-active').forEach(function (b) {
          b.classList.remove('is-active');
        });
      }
    });
  })();
</script>

<style>
  /* ── Section wrapper ───────────────────────────────────────────────── */
  .gallery {
    background: var(--color-white);
    padding: var(--space-xl) 0;
  }

  .gallery-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-page-padding-h);
  }

  /* ── Header ───────────────────────────────────────────────────────── */
  .gallery-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .gallery-eyebrow {
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-btn);
    letter-spacing: var(--letter-spacing-btn);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .gallery-headline {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-black);
    margin: 0;
  }

  /* ── Honeycomb grid ────────────────────────────────────────────────── */
  /*
   * The interlocking pattern works because:
   * 1. Grid columns are square cells of size `--cell`.
   * 2. Each photo spans 2 columns AND has aspect-ratio: 1 — so it is
   *    `2 * --cell` wide and `2 * --cell` tall.
   * 3. But each photo occupies ONE grid row (which is `--cell` tall).
   *    So the photo visually overflows DOWN by `--cell` (one row).
   * 4. Offset rows (every Nth photo) start at col 2, creating the
   *    half-tile horizontal shift. Combined with the vertical overflow,
   *    diamonds interlock pixel-perfect.
   */

  .gallery-grid {
    /* Desktop default — 50% bigger than original codepen */
    --cell: 150px;
    --gap: 20px;
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(8, var(--cell));
    grid-auto-rows: var(--cell);
    justify-content: center;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    /* Each cell visually overflows the grid's last row by `--cell + --gap`
       (that's the half-cell shift that produces the honeycomb interlock).
       Without padding-bottom matching that overflow, the cells from the
       last row spill out of the section and overlap the footer below. */
    padding-bottom: calc(var(--cell) + var(--gap));
  }

  /*
   * Each cell: 2 cells wide × 2 cells tall (square), overflowing one
   * grid row downward. `align-self: start` is critical — without it the
   * default `stretch` collapses the cell to the row height and breaks
   * the vertical overflow that produces the honeycomb interlock.
   */
  .gallery-cell {
    grid-column: span 2;
    align-self: start;
    width: calc(2 * var(--cell) + var(--gap));
    height: calc(2 * var(--cell) + var(--gap));
  }

  /* Honeycomb offset selectors per breakpoint.
     Desktop (8 cols): rows of 4 images, then 3 offset. Pattern: nth(7n+5). */
  .gallery-cell:nth-child(7n+5) {
    grid-column: 2 / span 2;
  }

  /* ── Tile ─────────────────────────────────────────────────────────── */
  .gallery-tile {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    position: relative;
    /* Rounded-diamond — exact bezier from the original CodePen
       (haptichash/eYojBbx), scaled to match this breakpoint's cell size.
       CSS clip-path: path() uses absolute pixel coords (no percentages),
       so a separate path string is hardcoded at each breakpoint below.
       Default: visual cell = 2 × 150 + 4gap = 304px.
       Both diamond and square paths have the same 8-curve structure so
       browsers interpolate smoothly during the morph animation. */
    clip-path: path("M 121.6 30.4 C 152 0 152 0 182.4 30.4 C 212.8 60.8 243.2 91.2 273.6 121.6 C 304 152 304 152 273.6 182.4 C 243.2 212.8 212.8 243.2 182.4 273.6 C 152 304 152 304 121.6 273.6 C 91.2 243.2 60.8 212.8 30.4 182.4 C 0 152 0 152 30.4 121.6 Z");
    transition: clip-path 500ms cubic-bezier(0.16, 1, 0.3, 1),
                filter 500ms ease;
  }

  /* Astro's Picture generates <picture><source><img></picture>. The <img>
     respects its intrinsic width/height attributes which can win over CSS
     `width: 100%` in some layout contexts. To guarantee the image fills the
     tile regardless, we position the <picture> absolutely inside the button
     (which has position: relative). The <img> inside fills the picture
     normally via width/height 100% + object-fit: cover. */
  .gallery-tile :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Interaction: hover (desktop) or tap-active (mobile) ──────────── */

  @media (hover: hover) {
    .gallery-grid:hover > .gallery-cell > .gallery-tile {
      filter: brightness(0.55) saturate(0.6);
    }
    .gallery-grid > .gallery-cell > .gallery-tile:hover {
      filter: brightness(1) saturate(1.15);
      z-index: 10;
      /* Rounded square — 8-curve bezier matching the diamond's structure
         so the morph is smooth. Scaled to 304px (default desktop). */
      clip-path: path("M 0 0 C 152 0 152 0 304 0 C 304 76 304 76 304 121.6 C 304 152 304 152 304 182.4 C 304 228 304 228 304 304 C 152 304 152 304 0 304 C 0 228 0 228 0 182.4 C 0 152 0 152 0 121.6 Z");
    }
  }

  /* Touch / click activation — works on all devices. The :not(.is-active)
     is critical: without it, :has() boosts the rule's specificity above
     the .is-active brightness override, so the clicked tile would also
     get dimmed. */
  .gallery-grid:has(.gallery-tile.is-active) > .gallery-cell > .gallery-tile:not(.is-active) {
    filter: brightness(0.55) saturate(0.6);
  }
  .gallery-grid > .gallery-cell > .gallery-tile.is-active {
    filter: brightness(1) saturate(1.15);
    z-index: 10;
    clip-path: path("M 0 0 C 152 0 152 0 304 0 C 304 76 304 76 304 121.6 C 304 152 304 152 304 182.4 C 304 228 304 228 304 304 C 152 304 152 304 0 304 C 0 228 0 228 0 182.4 C 0 152 0 152 0 121.6 Z");
  }

  /* Focus visible (keyboard) */
  .gallery-tile:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
    z-index: 11;
  }

  /* ── Large laptop (≤ 1366px) — slightly smaller cells ─────────────── */
  @media (max-width: 1366px) {
    .gallery-grid {
      --cell: 130px;
    }

    /* Cell visual size = 2 × 130 + 4gap = 264. Paths scaled by 264/200 = 1.32 */
    .gallery-tile {
      clip-path: path("M 105.6 26.4 C 132 0 132 0 158.4 26.4 C 184.8 52.8 211.2 79.2 237.6 105.6 C 264 132 264 132 237.6 158.4 C 211.2 184.8 184.8 211.2 158.4 237.6 C 132 264 132 264 105.6 237.6 C 79.2 211.2 52.8 184.8 26.4 158.4 C 0 132 0 132 26.4 105.6 Z");
    }
    @media (hover: hover) {
      .gallery-grid > .gallery-cell > .gallery-tile:hover {
        clip-path: path("M 0 0 C 132 0 132 0 264 0 C 264 66 264 66 264 105.6 C 264 132 264 132 264 158.4 C 264 198 264 198 264 264 C 132 264 132 264 0 264 C 0 198 0 198 0 158.4 C 0 132 0 132 0 105.6 Z");
      }
    }
    .gallery-grid > .gallery-cell > .gallery-tile.is-active {
      clip-path: path("M 0 0 C 132 0 132 0 264 0 C 264 66 264 66 264 105.6 C 264 132 264 132 264 158.4 C 264 198 264 198 264 264 C 132 264 132 264 0 264 C 0 198 0 198 0 158.4 C 0 132 0 132 0 105.6 Z");
    }
  }

  /* ── Tablet (≤ 1024px) — 6 columns ────────────────────────────────── */
  @media (max-width: 1024px) {
    .gallery-grid {
      --cell: 110px;
      grid-template-columns: repeat(6, var(--cell));
    }

    /* Reset desktop offset, apply tablet-specific.
       6-col grid: rows of 3 images, then 2 offset. Pattern: nth(5n+4). */
    .gallery-cell:nth-child(7n+5) {
      grid-column: span 2;
    }
    .gallery-cell:nth-child(5n+4) {
      grid-column: 2 / span 2;
    }

    /* Cell visual size = 2 × 110 + 4gap = 224. Paths scaled by 224/200 = 1.12 */
    .gallery-tile {
      clip-path: path("M 89.6 22.4 C 112 0 112 0 134.4 22.4 C 156.8 44.8 179.2 67.2 201.6 89.6 C 224 112 224 112 201.6 134.4 C 179.2 156.8 156.8 179.2 134.4 201.6 C 112 224 112 224 89.6 201.6 C 67.2 179.2 44.8 156.8 22.4 134.4 C 0 112 0 112 22.4 89.6 Z");
    }
    @media (hover: hover) {
      .gallery-grid > .gallery-cell > .gallery-tile:hover {
        clip-path: path("M 0 0 C 112 0 112 0 224 0 C 224 56 224 56 224 89.6 C 224 112 224 112 224 134.4 C 224 168 224 168 224 224 C 112 224 112 224 0 224 C 0 168 0 168 0 134.4 C 0 112 0 112 0 89.6 Z");
      }
    }
    .gallery-grid > .gallery-cell > .gallery-tile.is-active {
      clip-path: path("M 0 0 C 112 0 112 0 224 0 C 224 56 224 56 224 89.6 C 224 112 224 112 224 134.4 C 224 168 224 168 224 224 C 112 224 112 224 0 224 C 0 168 0 168 0 134.4 C 0 112 0 112 0 89.6 Z");
    }
  }

  /* ── Small tablet (≤ 700px) — same 6 cols, smaller cells ─────────── */
  @media (max-width: 700px) {
    .gallery-grid {
      --cell: 90px;
    }

    /* Cell visual size = 2 × 90 + 4gap = 184. Paths scaled by 184/200 = 0.92 */
    .gallery-tile {
      clip-path: path("M 73.6 18.4 C 92 0 92 0 110.4 18.4 C 128.8 36.8 147.2 55.2 165.6 73.6 C 184 92 184 92 165.6 110.4 C 147.2 128.8 128.8 147.2 110.4 165.6 C 92 184 92 184 73.6 165.6 C 55.2 147.2 36.8 128.8 18.4 110.4 C 0 92 0 92 18.4 73.6 Z");
    }
    @media (hover: hover) {
      .gallery-grid > .gallery-cell > .gallery-tile:hover {
        clip-path: path("M 0 0 C 92 0 92 0 184 0 C 184 46 184 46 184 73.6 C 184 92 184 92 184 110.4 C 184 138 184 138 184 184 C 92 184 92 184 0 184 C 0 138 0 138 0 110.4 C 0 92 0 92 0 73.6 Z");
      }
    }
    .gallery-grid > .gallery-cell > .gallery-tile.is-active {
      clip-path: path("M 0 0 C 92 0 92 0 184 0 C 184 46 184 46 184 73.6 C 184 92 184 92 184 110.4 C 184 138 184 138 184 184 C 92 184 92 184 0 184 C 0 138 0 138 0 110.4 C 0 92 0 92 0 73.6 Z");
    }
  }

  /* ── Mobile (≤ 540px) — 4 columns ────────────────────────────────── */
  @media (max-width: 540px) {
    .gallery {
      padding: var(--space-lg) 0;
    }

    .gallery-inner {
      padding: 0 var(--space-sm);
    }

    .gallery-headline {
      font-size: var(--font-size-h3);
    }

    .gallery-grid {
      --cell: 80px;
      grid-template-columns: repeat(4, var(--cell));
    }

    /* 4-col grid: rows of 2 images, then 1 offset. Pattern: nth(3n). */
    .gallery-cell:nth-child(5n+4) {
      grid-column: span 2;
    }
    .gallery-cell:nth-child(3n) {
      grid-column: 2 / span 2;
    }

    /* Cell visual size = 2 × 80 + 4gap = 164. Paths scaled by 164/200 = 0.82 */
    .gallery-tile {
      clip-path: path("M 65.6 16.4 C 82 0 82 0 98.4 16.4 C 114.8 32.8 131.2 49.2 147.6 65.6 C 164 82 164 82 147.6 98.4 C 131.2 114.8 114.8 131.2 98.4 147.6 C 82 164 82 164 65.6 147.6 C 49.2 131.2 32.8 114.8 16.4 98.4 C 0 82 0 82 16.4 65.6 Z");
    }
    @media (hover: hover) {
      .gallery-grid > .gallery-cell > .gallery-tile:hover {
        clip-path: path("M 0 0 C 82 0 82 0 164 0 C 164 41 164 41 164 65.6 C 164 82 164 82 164 98.4 C 164 123 164 123 164 164 C 82 164 82 164 0 164 C 0 123 0 123 0 98.4 C 0 82 0 82 0 65.6 Z");
      }
    }
    .gallery-grid > .gallery-cell > .gallery-tile.is-active {
      clip-path: path("M 0 0 C 82 0 82 0 164 0 C 164 41 164 41 164 65.6 C 164 82 164 82 164 98.4 C 164 123 164 123 164 164 C 82 164 82 164 0 164 C 0 123 0 123 0 98.4 C 0 82 0 82 0 65.6 Z");
    }
  }

  /* ── Reduced motion ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .gallery-tile {
      transition: filter 200ms ease !important;
    }
  }
</style>
