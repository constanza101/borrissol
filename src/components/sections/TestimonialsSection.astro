---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { REVIEWS } from '../../config/reviews';

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);

const MAPS_URL = 'https://maps.app.goo.gl/PVvxzbJMCfh1zR316';

const accentColors = [
  'var(--color-tufting-express)',
  'var(--color-tufting-intro)',
  'var(--color-tufting-intermediate)',
  'var(--color-tufting-pro)',
];

const reviews = REVIEWS.map(r => ({ name: r.name, text: t.dyn(r.key) }));
---

<section id="testimonials" class="testimonials" aria-labelledby="testimonials-heading">
  <div class="t-inner">

    <!-- Header row: text left, arrows right -->
    <div class="t-header">
      <div class="t-header-text">
        <span class="eyebrow reveal">{t('testimonials.eyebrow')}</span>
        <h2 id="testimonials-heading" class="t-headline reveal" data-delay="1">{t('testimonials.headline')}</h2>
      </div>
      <div class="t-nav" aria-label={t('a11y.carousel.nav')}>
        <button class="t-nav-btn" id="t-prev" aria-label={t('a11y.carousel.prev')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        </button>
        <button class="t-nav-btn" id="t-next" aria-label={t('a11y.carousel.next')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- Carousel -->
    <div class="t-carousel-wrap reveal" data-delay="2">
      <ul class="t-carousel" id="t-carousel" role="list">
        {reviews.map((r, i) => (
          <li class="t-card">
            <p class="t-stars" aria-label={t('a11y.stars')}>★★★★★</p>
            <p class="t-text">{r.text}</p>
            <div class="t-footer">
              <span
                class="t-avatar"
                aria-hidden="true"
                style={`background:${accentColors[i % 4]}`}
              >
                {r.name.charAt(0)}
              </span>
              <div class="t-author">
                <span class="t-name">{r.name}</span>
                <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="t-source">
                  {t('testimonials.source')}
                </a>
              </div>
              <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="t-google" aria-label={t('testimonials.source')}>
                <img src="/images/google-g.png" alt="" width="22" height="22" loading="lazy" />
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom CTA -->
    <div class="t-cta-wrap reveal">
      <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="link-arrow t-cta-link">
        {t('testimonials.cta')}
      </a>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    var carousel = document.getElementById('t-carousel');
    if (!carousel) return;
    var prev = document.getElementById('t-prev');
    var next = document.getElementById('t-next');

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var originals = Array.prototype.slice.call(carousel.children);
    var N = originals.length;
    if (N < 2) return;

    // ── Endless track ──────────────────────────────────────────────────────
    // Clone a full set before AND after the originals. The content is then
    // periodic: every position has an identical twin one set-width away, so we
    // can shift scrollLeft by whole set-widths invisibly to fake an infinite
    // loop. Clones are hidden from assistive tech and removed from the tab order.
    function markClone(el) {
      el.setAttribute('aria-hidden', 'true');
      var f = el.querySelectorAll('a, button, [tabindex]');
      for (var i = 0; i < f.length; i++) f[i].setAttribute('tabindex', '-1');
    }
    var before = document.createDocumentFragment();
    var after  = document.createDocumentFragment();
    originals.forEach(function (card) {
      var b = card.cloneNode(true); markClone(b); before.appendChild(b);
      var a = card.cloneNode(true); markClone(a); after.appendChild(a);
    });
    carousel.insertBefore(before, carousel.firstChild);
    carousel.appendChild(after);

    function gap()    { return parseFloat(getComputedStyle(carousel).gap) || 0; }
    function step()   { return originals[0].offsetWidth + gap(); }
    function spl()    { return parseFloat(getComputedStyle(carousel).scrollPaddingLeft) || 0; }
    function loopW()  { return step() * N; }
    function startX() { return originals[0].offsetLeft - spl(); }

    // Keep scrollLeft within one set-width of the middle (original) set. Each
    // correction is a whole set-width, so the visible pixels are identical.
    function recenter() {
      var lw = loopW(), sp = startX(), x = carousel.scrollLeft;
      while (x >= sp + lw) x -= lw;
      while (x < sp)       x += lw;
      if (x !== carousel.scrollLeft) carousel.scrollLeft = x;
    }

    carousel.scrollLeft = startX();   // begin on the first original card

    // Custom smooth scroll so the duration is tunable (native 'smooth' isn't).
    // Snap is disabled during the tween so it can't fight the per-frame scroll,
    // then restored — each step lands exactly on a snap point.
    var SCROLL_MS = 600;   // transition duration; raise this to slow it further
    var rafId = null;
    function tweenBy(delta) {
      if (rafId) cancelAnimationFrame(rafId);
      if (reduceMotion) { carousel.scrollLeft += delta; return; }
      var from = carousel.scrollLeft, startT = null;
      carousel.style.scrollSnapType = 'none';
      function frame(now) {
        if (startT === null) startT = now;
        var t = Math.min((now - startT) / SCROLL_MS, 1);
        var e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;   // easeInOutQuad
        carousel.scrollLeft = from + delta * e;
        if (t < 1) { rafId = requestAnimationFrame(frame); }
        else { rafId = null; carousel.style.scrollSnapType = ''; }
      }
      rafId = requestAnimationFrame(frame);
    }

    function go(dir) { tweenBy(dir * step()); }

    // Recenter once scrolling settles (covers both drag and the smooth steps),
    // never mid-animation, so the wrap stays invisible.
    var settle;
    carousel.addEventListener('scroll', function () {
      clearTimeout(settle);
      settle = setTimeout(recenter, 120);
    }, { passive: true });

    // ── Auto-advance every 3s, paused on interaction / hidden tab ───────────
    var timer = null;
    function play()  { if (reduceMotion || timer) return; timer = setInterval(function () { go(1); }, 3000); }
    function pause() { if (timer) { clearInterval(timer); timer = null; } }
    function bump(dir) { pause(); go(dir); setTimeout(play, 5000); }  // manual arrow

    if (prev) prev.addEventListener('click', function () { bump(-1); });
    if (next) next.addEventListener('click', function () { bump(1); });

    carousel.addEventListener('pointerenter', pause);
    carousel.addEventListener('pointerleave', play);
    carousel.addEventListener('focusin', pause);
    carousel.addEventListener('focusout', play);
    carousel.addEventListener('touchstart', pause, { passive: true });
    carousel.addEventListener('touchend', function () { setTimeout(play, 4000); }, { passive: true });
    document.addEventListener('visibilitychange', function () { document.hidden ? pause() : play(); });

    play();
  })();
</script>

<style>
  .testimonials {
    background: var(--color-light);
    border-top: var(--border-default);
    padding: var(--space-xl) 0;
  }

  .t-inner {
    padding: 0 var(--space-lg);
  }

  /* ── Header ── */
  .t-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .t-header-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .t-headline {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-black);
  }

  /* ── Arrow buttons ── */
  .t-nav {
    display: flex;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .t-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--min-touch-target);
    height: var(--min-touch-target);
    background: none;
    border: var(--border-default);
    border-radius: var(--radius-sharp);
    cursor: pointer;
    color: var(--color-black);
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .t-nav-btn:hover {
    background: var(--color-mid);
    border-color: var(--color-black);
  }

  /* ── Carousel wrapper + track ── */
  .t-carousel-wrap {
    overflow: hidden;
    width: 100%;
    margin-bottom: var(--space-lg);
  }

  .t-carousel {
    /* Sliver of the neighbouring card left visible as a scroll hint. */
    --t-peek: var(--space-lg);
    list-style: none;
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Snap inset so a snapped card leaves room for the previous card to peek on
       the left. There is no inset at scrollLeft 0, so the first group peeks
       only on the right; mid-scroll anchors peek on both sides. */
    scroll-padding-left: calc(var(--t-peek) + var(--space-sm));
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .t-carousel::-webkit-scrollbar { display: none; }

  /* ── Card: 3 fully visible + a peek on BOTH sides (see --t-peek).
        Width reserves two peeks + the four surrounding gaps so the left and
        right slivers can show at the same time mid-scroll. ── */
  .t-card {
    flex: 0 0 calc((100% - 4 * var(--space-sm) - 2 * var(--t-peek)) / 3);
    scroll-snap-align: start;
    background: var(--color-white);
    border-radius: var(--radius-lg);  /* card radius; borderless on purpose (light section bg) */
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
  }

  .t-stars {
    font-size: var(--font-size-p3);
    color: var(--color-star);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .t-text {
    font-size: var(--font-size-p3);
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
    letter-spacing: var(--letter-spacing-body);
    color: var(--color-black);
    flex: 1;
  }

  .t-footer {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: var(--border-default);
  }

  /* ── Avatar initial square ── */
  .t-avatar {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-btn);
    color: var(--color-white);
    text-transform: uppercase;
  }

  .t-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .t-name {
    font-size: var(--font-size-p3);
    font-weight: var(--font-weight-btn);
    color: var(--color-black);
    line-height: var(--line-height-ui);
  }

  .t-source {
    font-size: var(--font-size-ui);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .t-source:hover { color: var(--color-black); }

  /* Google logo — bottom-right of the card, links to the Google reviews. */
  .t-google {
    margin-left: auto;
    align-self: flex-end;
    display: inline-flex;
    flex-shrink: 0;
  }
  .t-google img {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* ── Bottom CTA ── */
  .t-cta-wrap {
    display: flex;
    justify-content: center;
    padding-top: var(--space-lg);
    border-top: var(--border-default);
  }


  /* ── Tablet: 2 cards + a peek on both sides ── */
  @media (max-width: 840px) {
    .t-card {
      flex: 0 0 calc((100% - 3 * var(--space-sm) - 2 * var(--t-peek)) / 2);
    }
    .t-nav { display: flex; }
  }

  /* ── Mobile: 1 card + a peek on both sides ── */
  @media (max-width: 540px) {
    .t-card {
      flex: 0 0 calc(100% - 2 * var(--space-sm) - 2 * var(--t-peek));
    }
    .t-nav { display: none; }
  }
</style>
